# RefXAS / XAFSDB VM environment template
# Copy to .env on the VM and replace every CHANGE_ME value.
# Do NOT commit the populated .env file.

SECRET_KEY=CHANGE_ME_DJANGO_SECRET
PREFIX=files

# Django/PostgreSQL
DB_NAME=xafsdb_pg
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DB_HOST=db
DB_PORT=5432

# SciCat application account used by auto creation
USERNAME_AUTH=admin
PASSWORD_AUTH=CHANGE_ME_SCICAT_PASSWORD
SCICAT_API_URL=http://scicat:3000

# Internal URL used by AutoDatasetCreation to call the Django file API
XAFSDB_INTERNAL_URL=http://127.0.0.1:8000

# Email/curator notification
EMAIL_HOST=CHANGE_ME_SMTP_HOST
EMAIL_HOST_USER=CHANGE_ME_EMAIL_USER
EMAIL_HOST_PASSWORD=CHANGE_ME_EMAIL_PASSWORD

# Object storage
AMAZON_ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY
AMAZON_SECRET_ACCESS_KEY=CHANGE_ME_SECRET_KEY
AMAZON_STORAGE_BUCKET_NAME=CHANGE_ME_BUCKET

# Mongo Express / deployment values (used by docker compose where configured)
ME_CONFIG_MONGODB_SERVER=mongodb
ME_CONFIG_MONGODB_PORT=27017
ME_CONFIG_MONGODB_ENABLE_ADMIN=true
ME_CONFIG_SITE_BASEURL=/mongodb
