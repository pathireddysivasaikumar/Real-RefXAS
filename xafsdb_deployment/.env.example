# Real refXAS environment template - copy to .env on the VM and fill real values.
PREFIX=file
SCICAT_HOST=http://scicat:3000
XAFSDB_FILE_HOST=http://127.0.0.1:8000

DB_HOST=db
DB_NAME=xafsdb_pg
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_PORT=5432

SECRET_KEY=CHANGE_ME_DJANGO_SECRET
USERNAME_AUTH=CHANGE_ME_SCICAT_FUNCTIONAL_USER
PASSWORD_AUTH=CHANGE_ME_SCICAT_FUNCTIONAL_PASSWORD

EMAIL_HOST=smtp.example.org
EMAIL_HOST_USER=refxas@example.org
EMAIL_HOST_PASSWORD=CHANGE_ME

AMAZON_ACCESS_KEY_ID=CHANGE_ME
AMAZON_SECRET_ACCESS_KEY=CHANGE_ME
AMAZON_STORAGE_BUCKET_NAME=CHANGE_ME

ME_CONFIG_MONGODB_SERVER=mongodb
ME_CONFIG_MONGODB_PORT=27017
ME_CONFIG_MONGODB_ENABLE_ADMIN=true
ME_CONFIG_SITE_BASEURL=/mongodb
